# AWS Diagram Generator - environment variables
# See also: frontend/.env.example (frontend build-time vars)
#           infra/config/public-prd.env.example (deployment config)

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# S3 bucket where generated .drawio files and specs are stored
S3_BUCKET=your-diagram-bucket

# Bedrock model used by the agent (Claude Haiku by default)
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Cognito (auth) - only needed for the hosted/public deployment
COGNITO_DOMAIN_PREFIX=your-app-prd
FRONTEND_URL=http://localhost:5173
FRONTEND_BUCKET=your-app-web-prd
